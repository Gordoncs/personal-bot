{
  "name": "personal-bot",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "node --env-file-if-exists=.env --import tsx src/login.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "chat": "node --env-file-if-exists=.env --import tsx src/chat-cli.ts",
    "ask": "node --env-file-if-exists=.env --import tsx scripts/ask.ts",
    "selftest": "node --import tsx scripts/selftest.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "feishu:check": "node --env-file-if-exists=.env --import tsx scripts/feishu-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "weixin-agent-sdk": "0.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
